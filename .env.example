# T_Hotel - bien moi truong mau. Copy sang .env va dien gia tri that.
# R6: KHONG commit .env. File nay chi chua gia tri gia.

# --- API ---
NODE_ENV=development
PORT=3001

# --- Postgres ---
# Track A (Supabase): lay tai Supabase Dashboard > Project Settings > Database > Connection string > URI
# Nho thay [YOUR-PASSWORD] bang database password (khac voi API key).
# Vi du: postgresql://postgres.abcdefghijklm:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
# Track B / local: postgresql://postgres:postgres@localhost:5432/t_hotel
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/t_hotel
# Bat SSL khi tro toi Supabase hoac Postgres co TLS
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# --- Supabase Auth ---
# Lay tai Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Dashboard > Project Settings > API Keys > JWT Keys > "JWT Secret" (legacy HS256)
# API chi dung secret nay de XAC MINH chu ky token, khong bao gio phat hanh token.
SUPABASE_JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters
# Issuer mong doi trong JWT, thuong la <SUPABASE_URL>/auth/v1
SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1

# --- CORS (Giai doan 2 se dung) ---
CORS_ORIGINS=http://localhost:3000
